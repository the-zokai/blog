---
layout: null
sitemap: false
---
[
{% for p in site.posts %}
  {
    "title": {{ p.title | jsonify }},
    "url": {{ p.url | relative_url | jsonify }},
    "date": {{ p.date | date: "%d/%m/%Y" | jsonify }},
    "categories": {{ p.categories | jsonify }},
    "tags": {{ p.tags | jsonify }},
    "description": {{ p.description | default: p.excerpt | strip_html | replace: "\n", " " | normalize_whitespace | truncate: 160 | jsonify }},
    "content": {{ p.content | strip_html | replace: "\n", " " | normalize_whitespace | truncate: 4000 | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
